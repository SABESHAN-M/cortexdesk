{
  "name": "cortexdesk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"web,api\" --prefix-colors \"blue,green\" \"npm run dev --prefix frontend\" \"uv run --directory backend uvicorn --reload --reload-exclude *.venv* --port 8000 main:app\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "backend\\.venv\\Scripts\\uvicorn main:app --reload --port 8000 --app-dir backend",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test": "uv run --directory backend pytest tests"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}