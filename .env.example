# ==============================================================================
# CortexDesk — Root Environment Configuration Template (.env.example)
#
# This file is the single source of truth for all environment variables across:
#   1. Web Frontend (Next.js)      -> copied to frontend/.env.local (public vars only)
#   2. API Backend (FastAPI)       -> copied to backend/.env (server-only vars)
#   3. Local Infrastructure        -> used by docker-compose.yml
#
# Copy this file to .env, frontend/.env.local, and backend/.env as appropriate:
#   npm run setup
# ==============================================================================

# ===== Application Environment & Metadata =====
# Consumed by: Backend, Frontend, CI/CD
APP_NAME=cortexdesk
APP_ENV=development
GIT_SHA=

# ===== Networking & Ports =====
# Consumed by: Root orchestration, Docker Compose, Local dev
FRONTEND_PORT=3000
BACKEND_PORT=8000
INTERNAL_API_URL=http://localhost:8000

# ===== Frontend Configuration (Browser-Accessible) =====
# CRITICAL: Only variables prefixed with NEXT_PUBLIC_ are bundled into client code.
# Never place secret keys, service-role keys, or database credentials here.
# Consumed by: Frontend (Next.js)
NEXT_PUBLIC_APP_NAME=cortexdesk
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ===== Backend Server & Security =====
# Consumed by: Backend (FastAPI)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Supabase Server-Side Integration (Privileged) =====
# Server-only credentials. MUST NEVER be exposed to the browser or prefixed with NEXT_PUBLIC_.
# Consumed by: Backend (FastAPI)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-server-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-server-only

# ===== Local PostgreSQL & pgvector Infrastructure =====
# Consumed by: Docker Compose (docker-compose.yml), Backend Database connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=cortexdesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your-local-postgres-password@localhost:5432/cortexdesk

# ===== Backend: LLM & Embedding Integrations (Upcoming Tasks) =====
# Consumed by: Backend (FastAPI agentic pipelines)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=gemini
LLM_MODEL=your-provider-model-id
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# ===== Backend: Agent & Search Tools (Upcoming Tasks) =====
# Consumed by: Backend (FastAPI agent executor)
TAVILY_API_KEY=your-tavily-api-key
MCP_SERVER_COMMAND=uv run python mcp_server.py
MAX_ROUNDS=5
MAX_ATTEMPTS=2
RECURSION_LIMIT=40

# ===== Backend: Document Ingestion & RAG (Upcoming Tasks) =====
# Consumed by: Backend (FastAPI RAG pipeline)
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MATCH_THRESHOLD=0.55
TOP_K_MAX=8