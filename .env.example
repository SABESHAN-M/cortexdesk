
# ===== App =====
APP_NAME=cortxdesk
APP_ENV=development
GIT_SHA=

# ===== Frontend (public values only) =====
NEXT_PUBLIC_APP_NAME=cortxdesk
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ===== Backend: server and CORS =====
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ===== Backend: Supabase =====
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_JWT_SECRET=your-jwt-secret-if-required

# ===== Backend: LLM and embeddings =====
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=gemini
LLM_MODEL=your-provider-model-id
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# ===== Backend: tools and web search =====
TAVILY_API_KEY=your-tavily-api-key
MCP_SERVER_COMMAND=uv run python mcp_server.py

# ===== Backend: agent limits =====
MAX_ROUNDS=5
MAX_ATTEMPTS=2
RECURSION_LIMIT=40

# ===== Backend: documents and RAG =====
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MATCH_THRESHOLD=0.55
TOP_K_MAX=8

# ===== Local database (Docker Compose, optional) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=cortxdesk