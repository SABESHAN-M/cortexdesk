# ===== App =====
APP_NAME=cortxdesk
APP_ENV=development                     # development | staging | production
GIT_SHA=

# ===== Frontend (public, safe in browser) =====
NEXT_PUBLIC_APP_NAME=cortxdesk
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# ===== Backend: server and CORS =====
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ===== Backend: Supabase =====
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_JWT_SECRET=                    # SECRET - legacy HS256 projects only

# ===== Backend: LLM and embeddings (SECRET keys) =====
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini                     # gemini | groq
LLM_MODEL=<current-flash-model-id>
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# ===== Backend: tools and web search =====
TAVILY_API_KEY=                         # SECRET (or use ddgs, no key needed)
MCP_SERVER_COMMAND=uv run python mcp_server.py

# ===== Backend: agent limits =====
MAX_ROUNDS=5
MAX_ATTEMPTS=2
RECURSION_LIMIT=40

# ===== Backend: documents and RAG =====
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MATCH_THRESHOLD=0.55
TOP_K_MAX=8

# ===== Local database (docker-compose, optional) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cortxdesk