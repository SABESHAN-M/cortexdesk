# ==============================================================================
# CortexDesk — Backend Environment Template (backend/.env.example)
#
# Copy this file to backend/.env:
#   npm run setup
# ==============================================================================

# ===== Required for Baseline Health Service =====
APP_NAME=cortexdesk
APP_ENV=development
BACKEND_PORT=8000
# Comma-separated allowed origins (defaults to http://localhost:3000 if unset)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Optional for Health Check / Required for Subsequent Milestones =====

# PostgreSQL & pgvector Database Connection
# Used by local docker-compose service and backend database clients
DATABASE_URL=postgresql://postgres:your-local-postgres-password@localhost:5432/cortexdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=cortexdesk
POSTGRES_PORT=5432

# Supabase Server-Side Integration (Privileged)
# Server-only keys: NEVER prefix with NEXT_PUBLIC_ or expose to browser code
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-server-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-server-only